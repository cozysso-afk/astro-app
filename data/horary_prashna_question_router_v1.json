{
  "version": "horary-prashna-question-router-v1",
  "language": "ko",
  "purpose": "별빛의 운명 Horary+Prashna 자유질문을 계산 규칙으로 라우팅하기 위한 few-shot 분류 사전",
  "principles": {
    "classification_only": true,
    "llm_must_not_judge_chart": true,
    "multi_intent": true,
    "confidence_threshold_auto_route": 0.8,
    "confidence_threshold_clarify": 0.55,
    "fallback_primary_type": "GENERAL_EVENT",
    "notes": [
      "질문 분류 단계는 해석을 만들지 않고 도메인·의도·대상·선택지만 구조화한다.",
      "Western Horary와 Prashna는 각각 독립 규칙으로 판단하고 마지막에만 일치/부분일치/상충을 비교한다.",
      "정확한 사실 확인이 필요한 건강·법률·금융·제3자 사생활 질문은 점성술적 상징으로만 표현하고 사실 단정이나 전문적 의사결정을 대신하지 않는다.",
      "Western Horary의 전통 주인성은 고전 7행성 sign ruler를 기본으로 하고 외행성을 sign ruler로 쓰지 않는다.",
      "Prashna 라우팅은 D1 Whole Sign bhava를 기본으로 하며 학파별 특수 규칙은 V1에서 강제하지 않는다."
    ]
  },
  "classifier_contract": {
    "required_output_fields": [
      "primary_type",
      "intents",
      "policy_id",
      "subject",
      "counterparty",
      "options",
      "confidence",
      "needs_clarification",
      "clarification_question"
    ],
    "primary_types": [
      "LOST_ITEM",
      "RELATIONSHIP",
      "CAREER",
      "EXAM_EDUCATION",
      "MONEY",
      "BUSINESS_CONTRACT",
      "PROPERTY_MOVE",
      "TRAVEL_FOREIGN",
      "HEALTH",
      "LEGAL_CONFLICT",
      "FAMILY_CHILDREN",
      "COMMUNICATION_NEWS",
      "GENERAL_EVENT"
    ],
    "intents": [
      "YES_NO",
      "TIMING",
      "LOCATION",
      "RECOVERY",
      "CONTACT",
      "RECONCILIATION",
      "COMMITMENT",
      "OPTION_RANKING",
      "ACTION_ADVICE",
      "OUTCOME",
      "CAUSE",
      "THIRD_PARTY_SYMBOLISM",
      "THEFT_SYMBOLISM",
      "JOB_OFFER",
      "PROMOTION",
      "PASS_FAIL",
      "PURCHASE_SALE",
      "SIGNING",
      "PAYMENT",
      "MOVE",
      "TRAVEL",
      "CONFLICT_RESOLUTION",
      "NEWS_RESULT"
    ],
    "option_rule": "명시된 선택지가 2개 이상이면 OPTION_RANKING을 추가하고 사용자의 원문 순서를 보존한다.",
    "clarification_rule": "질문의 대상 하우스가 달라질 정도로 핵심 대상이 모호하거나 confidence<0.55이면 한 번만 짧게 확인한다."
  },
  "policies": {
    "H_LOST_ITEM": {
      "domain": "분실물·위치",
