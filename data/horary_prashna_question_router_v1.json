          "Lagna",
          "Lagna lord",
          "Moon",
          "2H",
          "2H lord"
        ],
        "secondary": [
          "4H for home/property context",
          "7H when another person/theft is relevant"
        ],
        "note": "D1 bhava strength and relevant lords are kept separate from Western scoring."
      },
      "default_outputs": [
        "ranked_options",
        "location_clues",
        "recovery_tendency",
        "timing_if_supported"
