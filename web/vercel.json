{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "fix/reunion-hierarchy-v2": true,
      "*": false,
      "**/*": false,
      "main": true
    }
  },
  "ignoreCommand": "BASE=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git diff --quiet \"$BASE\" HEAD -- ':(top)web'"
}
